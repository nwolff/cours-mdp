<!doctype html>
<html lang="fr">

<head>
  {% block head %}
  <title>{% block title %}{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/static/bootstrap.min.css" rel="stylesheet" media="screen" />
  <link href="/static/favicon.ico" rel="icon" type="image/x-icon" />
  {% block extrahead %}{% endblock %} {% endblock %}
</head>

<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center" href="/" aria-label="Accueil">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16"
          aria-hidden="true">
          <path
            d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146z" />
        </svg>
      </a>
      <button class="navbar-toggler" type="button" aria-controls="navContent" aria-expanded="false" aria-label="Menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav">
          <a class="nav-item nav-link mx-2 {% block nav_register %}{% endblock %}" href="register">Créer un compte</a>
          <a class="nav-item nav-link mx-2 {% block nav_login %}{% endblock %}" href="login">Se connecter</a>
          <a class="nav-item nav-link mx-2 {% block nav_listusers %}{% endblock %}" href="listusers">Liste des
            comptes</a>
        </ul>
      </div>
    </div>
  </nav>

  <div id="content" class="container pt-5">
    {% block content %}{% endblock %}
  </div>

  <script>
    document.querySelector('.navbar-toggler').addEventListener('click', (e) => {
      const target = document.getElementById('navContent');
      const expanded = target.classList.toggle('show');
      e.currentTarget.setAttribute('aria-expanded', expanded);
    });
  </script>
</body>

</html>