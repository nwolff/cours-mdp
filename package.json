		"elm-test": "0.19.2-1",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vite-plugin-elm": "^3.0.1",
		"vitest": "^5.0.3"
	}
